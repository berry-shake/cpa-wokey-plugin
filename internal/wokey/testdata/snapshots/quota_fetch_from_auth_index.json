{
  "case": "quota_fetch_from_auth_index",
  "description": "quota.fetch without storage reads the auth file by auth_index; an unknown index has no key.",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}"
    },
    "credentials": [
      {
        "name": "k1.json",
        "fields": {
          "api_key": "sk-wk-snapshot-fake-0001",
          "label": "primary",
          "type": "wokey"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "GET",
      "path": "/v1/dashboard/balance",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"marketOrderId\":\"order-77\",\"availableUsd\":\"3.25\"}",
      "chunks": []
    },
    {
      "method": "GET",
      "path": "/v1/key",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"usage\":9,\"usage_monthly\":\"6.75\",\"limit\":null}",
      "chunks": []
    }
  ],
  "steps": [
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-1",
          "auth_id": "k1.json",
          "provider": "wokey",
          "host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-snapshot-1"
        }
      },
      "output": {
        "upstream_requests": [
          {
            "method": "GET",
            "path": "/v1/dashboard/balance",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-wk-snapshot-fake-0001"
              ],
              "User-Agent": [
                "cpa-wokey-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          },
          {
            "method": "GET",
            "path": "/v1/key",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-wk-snapshot-fake-0001"
              ],
              "User-Agent": [
                "cpa-wokey-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          }
        ],
        "host_calls": [
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          }
        ],
        "response": {
          "ok": true,
          "result": {
            "groups": [
              {
                "displayName": "Wokey",
                "buckets": [
                  {
                    "window": "monthly",
                    "remainingFraction": 0.325
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-9",
          "auth_id": "missing.json",
          "provider": "wokey",
          "host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-snapshot-1"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-9"
            }
          }
        ],
        "response": {
          "ok": false,
          "error": {
            "code": "invalid_credential",
            "message": "wokey: credential has no api_key",
            "http_status": 401
          }
        }
      }
    }
  ]
}
