          "application/json"
        ]
      },
      "body": "{\"ip\":\"203.0.113.7\",\"city\":\"Tokyo\",\"region\":\"Tokyo\",\"country\":\"jp\"}",
      "chunks": []
    }
  ],
  "steps": [
