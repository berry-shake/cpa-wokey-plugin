                "label": "socks5://10.0.0.1:1080",
                "created_at": "<volatile>"
              },
              "updated_credentials": 0
            }
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Method": "POST",
          "Path": "/v0/management/plugins/wokey/proxies",
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Query": null,
