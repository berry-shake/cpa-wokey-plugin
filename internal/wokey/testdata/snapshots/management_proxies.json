            "Body": {
              "error": "invalid_proxy",
              "message": "url: invalid proxy_url: unsupported scheme \"ftp\" (use http, https, socks5 or socks5h)"
            }
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Method": "DELETE",
          "Path": "/v0/management/plugins/wokey/proxies",
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Query": {
            "id": [
              "000000000000"
            ]
          },
          "Body": null,
          "host_callback_id": "cb-snapshot-1"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "StatusCode": 404,
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "Body": {
              "error": "proxy_not_found",
              "message": "no listed proxy has this id"
            }
          }
        }
      }
    },
    {
      "rpc": {
