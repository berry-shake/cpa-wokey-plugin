      "data-dir": "{{DATA_DIR}}"
    },
    "credentials": [
      {
        "name": "k1.json",
        "fields": {
          "api_key": "sk-wk-snapshot-fake-0001",
          "label": "primary",
          "type": "wokey"
        }
      },
      {
        "name": "k2.json",
        "fields": {
          "api_key": "sk-wk-snapshot-fake-0002",
