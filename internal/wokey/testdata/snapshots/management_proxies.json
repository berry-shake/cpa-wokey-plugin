              "message": "this proxy URL is already in the list"
            }
          }
        }
      }
    },
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Method": "POST",
          "Path": "/v0/management/plugins/wokey/proxies",
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Query": null,
          "Body": {
            "name": "Bad",
            "url": "ftp://10.0.0.3"
          },
          "host_callback_id": "cb-snapshot-1"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "StatusCode": 400,
            "Headers": {
