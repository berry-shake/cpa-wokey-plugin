{
  "case": "credential_auth_rpcs",
  "description": "auth.parse (Wokey file, other provider, no key), auth.refresh and the unsupported login flow.",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}"
    },
    "credentials": []
  },
  "upstream_script": [],
  "steps": [
    {
      "rpc": {
        "method": "auth.parse",
        "request": {
          "Provider": "wokey",
          "Path": "/auths/new.json",
          "FileName": "new.json",
          "RawJSON": {
            "type": "wokey",
            "api_key": "sk-wk-snapshot-fake-0002",
            "prefix": "wk",
            "proxy_url": "direct",
            "disabled": true
          },
          "Host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Handled": true,
            "Auth": {
              "Provider": "wokey",
              "ID": "",
              "FileName": "new.json",
              "Label": "new",
              "Prefix": "wk",
              "ProxyURL": "direct",
              "Disabled": true,
              "StorageJSON": {
                "type": "wokey",
                "api_key": "sk-wk-snapshot-fake-0002",
                "prefix": "wk",
                "proxy_url": "direct",
                "disabled": true
              },
              "Metadata": {
                "api_key": "sk-wk-snapshot-fake-0002",
                "disabled": true,
                "prefix": "wk",
                "proxy_url": "direct",
                "type": "wokey"
              },
              "Attributes": null,
              "NextRefreshAfter": "2027-01-02T03:04:05Z"
            },
            "Auths": null
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.parse",
        "request": {
          "Provider": "wokey",
          "Path": "/auths/codex.json",
          "FileName": "codex.json",
          "RawJSON": {
            "type": "codex",
            "access_token": "fake"
          },
          "Host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Handled": false,
            "Auth": {
              "Provider": "",
              "ID": "",
              "FileName": "",
              "Label": "",
              "Prefix": "",
              "ProxyURL": "",
              "Disabled": false,
              "StorageJSON": null,
              "Metadata": null,
              "Attributes": null,
              "NextRefreshAfter": "0001-01-01T00:00:00Z"
            },
            "Auths": null
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.parse",
        "request": {
          "Provider": "wokey",
          "Path": "/auths/empty.json",
          "FileName": "empty.json",
          "RawJSON": {
            "type": "wokey"
          },
          "Host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "invalid_auth",
            "message": "wokey auth file empty.json has no api_key"
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.refresh",
        "request": {
          "AuthID": "k1.json",
          "AuthProvider": "wokey",
          "StorageJSON": {
            "api_key": "sk-wk-snapshot-fake-0001",
            "label": "primary",
            "type": "wokey"
          },
          "Metadata": {
            "label": "from metadata"
          },
          "Attributes": null,
          "Host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-snapshot-1"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Auth": {
              "Provider": "wokey",
              "ID": "k1.json",
              "FileName": "",
              "Label": "from metadata",
              "Prefix": "wokey",
              "ProxyURL": "",
              "Disabled": false,
              "StorageJSON": {
                "api_key": "sk-wk-snapshot-fake-0001",
                "label": "from metadata",
                "type": "wokey"
              },
              "Metadata": {
                "api_key": "sk-wk-snapshot-fake-0001",
                "label": "from metadata",
                "type": "wokey"
              },
              "Attributes": null,
              "NextRefreshAfter": "2027-01-02T03:04:05Z"
            },
            "NextRefreshAfter": "2027-01-02T03:04:05Z"
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.login.start",
        "request": {}
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "unsupported_login",
            "message": "Wokey uses API keys: add one on the Wokey plugin page or upload a wokey auth file",
            "http_status": 400
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.login.poll",
        "request": {}
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Status": "error",
            "Message": "Wokey uses API keys; there is no login flow",
            "Auth": {
              "Provider": "",
              "ID": "",
              "FileName": "",
              "Label": "",
              "Prefix": "",
              "ProxyURL": "",
              "Disabled": false,
              "StorageJSON": null,
              "Metadata": null,
              "Attributes": null,
              "NextRefreshAfter": "0001-01-01T00:00:00Z"
            },
            "Auths": null
          }
        }
      }
    }
  ]
}
