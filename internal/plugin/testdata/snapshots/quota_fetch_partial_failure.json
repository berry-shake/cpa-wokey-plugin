{
  "case": "quota_fetch_partial_failure",
  "description": "quota.fetch when the balance fails, then when both calls fail (the key's status wins).",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}"
    },
    "credentials": [
      {
        "name": "k1.json",
        "fields": {
          "api_key": "sk-wk-snapshot-fake-0001",
          "label": "primary",
          "type": "wokey"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "GET",
      "path": "/v1/dashboard/balance",
      "status": 500,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"error\":{\"message\":\"balance service down\"}}",
      "chunks": []
    },
    {
      "method": "GET",
      "path": "/v1/key",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"label\":\"primary key\",\"usage\":1.5,\"usage_daily\":0.25,\"usage_weekly\":1,\"usage_monthly\":1.5,\"limit\":10,\"limit_remaining\":8.5,\"limit_reset\":\"monthly\"}",
      "chunks": []
    },
    {
      "method": "GET",
      "path": "/v1/dashboard/balance",
      "status": 401,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"error\":{\"code\":\"invalid_api_key\",\"message\":\"invalid API key\"}}",
      "chunks": []
    },
    {
      "method": "GET",
      "path": "/v1/key",
      "status": 403,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"error\":{\"code\":\"key_disabled\",\"message\":\"key disabled\"}}",
      "chunks": []
    }
  ],
  "steps": [
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-1",
          "auth_id": "k1.json",
          "provider": "wokey",
          "storage_json": {
            "api_key": "sk-wk-snapshot-fake-0001",
            "label": "primary",
            "type": "wokey"
          },
          "metadata": {
            "api_key": "sk-wk-snapshot-fake-0001",
            "label": "primary",
            "type": "wokey"
          },
          "host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-snapshot-1"
        }
      },
      "output": {
        "upstream_requests": [
          {
            "method": "GET",
            "path": "/v1/dashboard/balance",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-wk-snapshot-fake-0001"
              ],
              "User-Agent": [
                "cpa-wokey-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          },
          {
            "method": "GET",
            "path": "/v1/key",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-wk-snapshot-fake-0001"
              ],
              "User-Agent": [
                "cpa-wokey-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          }
        ],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "balance_unavailable",
            "message": "wokey: read balance: wokey: balance service down",
            "http_status": 502
          }
        }
      }
    },
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-1",
          "auth_id": "k1.json",
          "provider": "wokey",
          "storage_json": {
            "api_key": "sk-wk-snapshot-fake-0001",
            "label": "primary",
            "type": "wokey"
          },
          "metadata": {
            "api_key": "sk-wk-snapshot-fake-0001",
            "label": "primary",
            "type": "wokey"
          },
          "host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-snapshot-1"
        }
      },
      "output": {
        "upstream_requests": [
          {
            "method": "GET",
            "path": "/v1/dashboard/balance",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-wk-snapshot-fake-0001"
              ],
              "User-Agent": [
                "cpa-wokey-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          },
          {
            "method": "GET",
            "path": "/v1/key",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer sk-wk-snapshot-fake-0001"
              ],
              "User-Agent": [
                "cpa-wokey-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          }
        ],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "key_disabled",
            "message": "wokey: key disabled",
            "http_status": 403
          }
        }
      }
    }
  ]
}
